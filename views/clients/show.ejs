<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Client Details</h1>
    <div>
        <a href="/clients" class="btn btn-secondary">Back to Clients</a>
        <a href="/clients/<%= client._id %>/edit" class="btn btn-primary">Edit Client</a>
    </div>
</div>

<!-- Client Information Card -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">Client Information</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <p><strong>Name:</strong> <%= client.name %></p>
                <p><strong>Mobile:</strong> <%= client.mobile %></p>
                <p><strong>Address:</strong> <%= client.address %></p>
                <p><strong>Priority:</strong>
                    <span class="badge <%= client.priority === 'High' ? 'bg-danger' : (client.priority === 'Mid' ? 'bg-warning' : 'bg-secondary') %>">
                        <%= client.priority || 'Mid' %>
                    </span>
                </p>
            </div>
            <div class="col-md-6">
                <p><strong>Status:</strong>
                    <span class="badge <%= client.status === 'Open' ? 'bg-success' : (client.status === 'Resolved' ? 'bg-info' : 'bg-secondary') %>">
                        <%= client.status || 'Open' %>
                    </span>
                </p>
                <p><strong>Interested:</strong> <%= client.interested ? 'Yes' : 'No' %></p>
                <% if (client.interested) { %>
                    <p><strong>Product/Service:</strong> <%= client.productService || '-' %></p>
                    <p><strong>Expected Amount:</strong> <%= client.expectedAmount ? '₹' + client.expectedAmount.toLocaleString() : '-' %></p>
                <% } %>
                <p><strong>Expected Timeline:</strong> <%= client.expectedTimeline ? client.expectedTimeline.toDateString() : '-' %></p>
                <p><strong>Last Visit Date:</strong> <%= client.lastVisitDate ? client.lastVisitDate.toDateString() : '-' %></p>
                <% if (client.closedAt) { %>
                    <p><strong>Closed/Resolved On:</strong> <%= client.closedAt.toDateString() %></p>
                <% } %>
            </div>
        </div>
        <% if (client.remarks) { %>
            <div class="mt-3">
                <strong>General Remarks:</strong>
                <p class="text-muted mt-1"><%= client.remarks %></p>
            </div>
        <% } %>
    </div>
</div>

<!-- Activity Timeline / Ticket Log -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Activity Timeline</h5>
        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addActivityModal">
            + Add Activity
        </button>
    </div>
    <div class="card-body">
        <% if (activities.length === 0) { %>
            <p class="text-muted">No activities recorded yet. Click "Add Activity" to add the first remark.</p>
        <% } else { %>
            <div class="timeline">
                <% activities.forEach(activity => { %>
                    <div class="timeline-item mb-3 pb-3 border-bottom">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="badge bg-secondary me-2"><%= activity.activityType || 'Note' %></span>
                                <strong><%= activity.createdAt ? activity.createdAt.toDateString() : '-' %></strong>
                                <small class="text-muted ms-2"><%= activity.createdAt ? activity.createdAt.toLocaleTimeString() : '' %></small>
                            </div>
                            <div>
                                <button class="btn btn-sm btn-outline-warning edit-activity" 
                                        data-id="<%= activity._id %>"
                                        data-remark="<%= activity.remark.replace(/"/g, '&quot;') %>"
                                        data-type="<%= activity.activityType %>">Edit</button>
                                <button class="btn btn-sm btn-outline-danger delete-activity" 
                                        data-id="<%= activity._id %>">Delete</button>
                            </div>
                        </div>
                        <p class="mt-2 mb-0"><%= activity.remark %></p>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>
</div>

<!-- Modal for Adding New Activity -->
<div class="modal fade" id="addActivityModal" tabindex="-1" aria-labelledby="addActivityModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addActivityModalLabel">Add Activity / Remark</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addActivityForm">
                    <div class="mb-3">
                        <label for="activityType" class="form-label">Activity Type</label>
                        <select class="form-select" id="activityType" name="activityType" required>
                            <option value="Call">Call</option>
                            <option value="Visit">Visit</option>
                            <option value="Email">Email</option>
                            <option value="Follow-up">Follow-up</option>
                            <option value="Note">Note</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="remark" class="form-label">Remark / Notes</label>
                        <textarea class="form-control" id="remark" name="remark" rows="3" required placeholder="Enter your notes here..."></textarea>
                    </div>
                    <div class="alert alert-danger d-none" id="activityErrorMsg"></div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="submitActivityBtn">Save Activity</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Editing Activity -->
<div class="modal fade" id="editActivityModal" tabindex="-1" aria-labelledby="editActivityModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editActivityModalLabel">Edit Activity</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editActivityForm">
                    <input type="hidden" id="editActivityId">
                    <div class="mb-3">
                        <label for="editActivityType" class="form-label">Activity Type</label>
                        <select class="form-select" id="editActivityType" name="activityType" required>
                            <option value="Call">Call</option>
                            <option value="Visit">Visit</option>
                            <option value="Email">Email</option>
                            <option value="Follow-up">Follow-up</option>
                            <option value="Note">Note</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="editRemark" class="form-label">Remark / Notes</label>
                        <textarea class="form-control" id="editRemark" name="remark" rows="3" required></textarea>
                    </div>
                    <div class="alert alert-danger d-none" id="editActivityErrorMsg"></div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="updateActivityBtn">Update Activity</button>
            </div>
        </div>
    </div>
</div>

<style>
    .timeline {
        max-height: 500px;
        overflow-y: auto;
    }
    .timeline-item {
        transition: background-color 0.2s;
    }
    .timeline-item:hover {
        background-color: #f8f9fa;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const clientId = '<%= client._id %>';
        
        // Get DOM elements with null checks
        const submitBtn = document.getElementById('submitActivityBtn');
        const activityType = document.getElementById('activityType');
        const remarkInput = document.getElementById('remark');
        const activityErrorMsg = document.getElementById('activityErrorMsg');
        
        // Add Activity
        if (submitBtn) {
            submitBtn.addEventListener('click', async function() {
                const selectedType = activityType ? activityType.value : 'Note';
                const remark = remarkInput ? remarkInput.value.trim() : '';
                
                if (!remark) {
                    if (activityErrorMsg) {
                        activityErrorMsg.textContent = 'Please enter a remark.';
                        activityErrorMsg.classList.remove('d-none');
                    }
                    return;
                }
                
                if (activityErrorMsg) {
                    activityErrorMsg.classList.add('d-none');
                }
                
                try {
                    const response = await fetch('/api/activities', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            clientId: clientId,
                            activityType: selectedType,
                            remark: remark
                        })
                    });
                    
                    if (response.ok) {
                        window.location.reload();
                    } else {
                        const error = await response.json();
                        if (activityErrorMsg) {
                            activityErrorMsg.textContent = error.error || 'Failed to add activity';
                            activityErrorMsg.classList.remove('d-none');
                        }
                    }
                } catch (err) {
                    if (activityErrorMsg) {
                        activityErrorMsg.textContent = 'Network error. Please try again.';
                        activityErrorMsg.classList.remove('d-none');
                    }
                }
            });
        }
        
        // Edit Activity - Populate modal
        const editButtons = document.querySelectorAll('.edit-activity');
        const editActivityId = document.getElementById('editActivityId');
        const editRemark = document.getElementById('editRemark');
        const editActivityType = document.getElementById('editActivityType');
        
        editButtons.forEach(btn => {
            btn.addEventListener('click', function() {
                const id = this.getAttribute('data-id');
                const remark = this.getAttribute('data-remark');
                const type = this.getAttribute('data-type');
                
                if (editActivityId) editActivityId.value = id;
                if (editRemark) editRemark.value = remark;
                if (editActivityType) editActivityType.value = type;
                
                const editModal = new bootstrap.Modal(document.getElementById('editActivityModal'));
                editModal.show();
            });
        });
        
        // Update Activity
        const updateBtn = document.getElementById('updateActivityBtn');
        const editActivityErrorMsg = document.getElementById('editActivityErrorMsg');
        
        if (updateBtn) {
            updateBtn.addEventListener('click', async function() {
                const id = editActivityId ? editActivityId.value : '';
                const selectedType = editActivityType ? editActivityType.value : 'Note';
                const remark = editRemark ? editRemark.value.trim() : '';
                
                if (!remark) {
                    if (editActivityErrorMsg) {
                        editActivityErrorMsg.textContent = 'Please enter a remark.';
                        editActivityErrorMsg.classList.remove('d-none');
                    }
                    return;
                }
                
                if (editActivityErrorMsg) {
                    editActivityErrorMsg.classList.add('d-none');
                }
                
                try {
                    const response = await fetch(`/api/activities/${id}`, {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            activityType: selectedType,
                            remark: remark
                        })
                    });
                    
                    if (response.ok) {
                        window.location.reload();
                    } else {
                        const error = await response.json();
                        if (editActivityErrorMsg) {
                            editActivityErrorMsg.textContent = error.error || 'Failed to update activity';
                            editActivityErrorMsg.classList.remove('d-none');
                        }
                    }
                } catch (err) {
                    if (editActivityErrorMsg) {
                        editActivityErrorMsg.textContent = 'Network error. Please try again.';
                        editActivityErrorMsg.classList.remove('d-none');
                    }
                }
            });
        }
        
        // Delete Activity
        const deleteButtons = document.querySelectorAll('.delete-activity');
        deleteButtons.forEach(btn => {
            btn.addEventListener('click', async function() {
                const id = this.getAttribute('data-id');
                
                if (!confirm('Are you sure you want to delete this activity? This cannot be undone.')) {
                    return;
                }
                
                try {
                    const response = await fetch(`/api/activities/${id}`, {
                        method: 'DELETE'
                    });
                    
                    if (response.ok) {
                        window.location.reload();
                    } else {
                        alert('Failed to delete activity');
                    }
                } catch (err) {
                    alert('Network error. Please try again.');
                }
            });
        });
        
        // Clear error when typing in add modal
        if (remarkInput) {
            remarkInput.addEventListener('input', function() {
                if (activityErrorMsg) activityErrorMsg.classList.add('d-none');
            });
        }
        
        // Clear error when typing in edit modal
        if (editRemark) {
            editRemark.addEventListener('input', function() {
                if (editActivityErrorMsg) editActivityErrorMsg.classList.add('d-none');
            });
        }
    });
</script>

<%- include('../partials/footer') %>